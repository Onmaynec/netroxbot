generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminLevel {
  SUPERADMIN
  ADMIN
}

enum PunishmentType {
  WARN
  TIMEOUT
  MUTE
  KICK
  BAN
  TEMP_BAN
  UNWARN
  CLEAR
  SLOWMODE
  LOCK
  UNLOCK
}

enum PunishmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model GuildConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  locale    String   @default("ru")
  accentHex String   @default("#57F287")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  modules   ModuleConfig[]
}

model ModuleConfig {
  id        String      @id @default(cuid())
  guildId   String
  moduleKey String
  enabled   Boolean     @default(true)
  settings  Json        @default("{}")
  guild     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  updatedAt DateTime    @updatedAt

  @@unique([guildId, moduleKey])
}

model AdminUser {
  id        String     @id @default(cuid())
  discordId String     @unique
  level     AdminLevel @default(ADMIN)
  addedBy   String?
  createdAt DateTime   @default(now())
  revokedAt DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  guildId    String
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([guildId, createdAt])
}

model ServerEvent {
  id         String   @id @default(cuid())
  guildId    String
  category   String
  eventType  String
  actorId    String?
  targetType String?
  targetId   String?
  channelId  String?
  messageId  String?
  summary    String
  payload    Json?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([guildId, occurredAt])
  @@index([guildId, category, occurredAt])
  @@index([guildId, eventType, occurredAt])
  @@index([guildId, targetId, occurredAt])
}

model BackupRecord {
  id          String   @id @default(cuid())
  fileName    String   @unique
  status      String
  sizeBytes   BigInt?
  checksum    String?
  error       String?
  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@index([status, startedAt])
}

model ModerationCounter {
  guildId        String @id
  nextCaseNumber Int    @default(1)
}

model ModerationCase {
  id              String           @id @default(cuid())
  caseNumber      Int
  guildId         String
  targetUserId    String?          @map("userId")
  targetChannelId String?          @map("channelId")
  moderatorId     String
  type            PunishmentType
  status          PunishmentStatus @default(ACTIVE)
  reason          String
  evidence        Json?
  durationSeconds Int?
  expiresAt       DateTime?
  dmDelivered     Boolean?
  cancelledBy     String?
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())
  appeals         Appeal[]

  @@unique([guildId, caseNumber])
  @@index([guildId, targetUserId])
  @@index([guildId, targetChannelId])
  @@index([guildId, moderatorId, createdAt])
  @@index([guildId, status, expiresAt])
  @@map("Punishment")
}

model Appeal {
  id           String         @id @default(cuid())
  guildId      String
  caseId       String         @map("punishmentId")
  userId       String
  text         String
  status       String         @default("PENDING")
  reviewerId   String?
  reviewNote   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  case         ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([caseId, status])
}

model AutomodEvent {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  channelId String
  messageId String?
  ruleKey   String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([guildId, userId, createdAt])
  @@index([guildId, ruleKey, createdAt])
}

model UserProfile {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  xp           BigInt   @default(0)
  level        Int      @default(1)
  reputation   Int      @default(0)
  messages     BigInt   @default(0)
  voiceSeconds BigInt   @default(0)
  bio          String?
  links        Json?
  cosmetics    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([guildId, userId])
}

model EconomyAccount {
  id             String   @id @default(cuid())
  guildId        String
  userId         String
  wallet         BigInt   @default(0)
  bank           BigInt   @default(0)
  seasonId       String?
  lifetimeEarned BigInt   @default(0)
  lifetimeSpent  BigInt   @default(0)
  lastDailyAt    DateTime?
  lastWorkAt     DateTime?
  lastMessageRewardAt DateTime?
  lastVoiceRewardAt DateTime?
  frozenAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, wallet])
  @@index([guildId, bank])
}

model EconomyTransaction {
  id                 String   @id @default(cuid())
  guildId            String
  userId             String
  counterpartyUserId String?
  amount             BigInt
  walletDelta        BigInt   @default(0)
  bankDelta          BigInt   @default(0)
  type               String
  referenceId        String?
  metadata           Json?
  createdAt          DateTime @default(now())

  @@index([guildId, userId, createdAt])
  @@index([guildId, type, createdAt])
  @@index([referenceId])
}

model EconomySeason {
  id            String   @id @default(cuid())
  guildId       String
  name          String
  status        String   @default("PLANNED")
  startsAt      DateTime
  endsAt        DateTime?
  resetBalances Boolean  @default(false)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([guildId, status, startsAt])
}

model EconomyTreasury {
  guildId       String   @id
  balance       BigInt   @default(0)
  minted        BigInt   @default(0)
  burned        BigInt   @default(0)
  collectedFees BigInt   @default(0)
  updatedAt     DateTime @updatedAt
}

model EconomyItemDefinition {
  id          String                @id @default(cuid())
  guildId     String
  sku         String
  name        String
  description String?
  rarity      String                @default("COMMON")
  itemType    String                @default("COLLECTIBLE")
  imageUrl    String?
  roleId      String?
  price       BigInt
  stock       Int?
  nextSerial  Int                   @default(1)
  maxPerUser  Int?
  tradable    Boolean               @default(true)
  giftable    Boolean               @default(true)
  active      Boolean               @default(true)
  metadata    Json?
  createdBy   String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  instances   EconomyItemInstance[]

  @@unique([guildId, sku])
  @@index([guildId, active, rarity])
}

model EconomyItemInstance {
  id           String                @id @default(cuid())
  guildId      String
  itemId       String
  ownerId      String
  serialNumber Int
  variant      Json?
  acquiredFrom String
  acquiredAt   DateTime              @default(now())
  lockedUntil  DateTime?
  lockKind     String?
  lockId       String?
  item         EconomyItemDefinition @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, serialNumber])
  @@index([guildId, ownerId, acquiredAt])
  @@index([guildId, ownerId, itemId])
  @@index([guildId, lockKind, lockId])
}

model EconomyLoan {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  principal   BigInt
  balance     BigInt
  interestBps Int
  status      String   @default("ACTIVE")
  dueAt       DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  paidAt      DateTime?

  @@index([guildId, userId, status])
  @@index([guildId, status, dueAt])
}

model EconomyRoleSalary {
  id              String                   @id @default(cuid())
  guildId         String
  roleId          String
  amount          BigInt
  intervalMinutes Int
  enabled         Boolean                  @default(true)
  createdBy       String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  claims          EconomyRoleSalaryClaim[]

  @@unique([guildId, roleId])
}

model EconomyRoleSalaryClaim {
  id            String            @id @default(cuid())
  salaryId      String
  userId        String
  lastClaimedAt DateTime
  salary        EconomyRoleSalary @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@unique([salaryId, userId])
  @@index([userId, lastClaimedAt])
}

model EconomyMarketplaceListing {
  id             String   @id @default(cuid())
  guildId        String
  sellerId       String
  itemInstanceId String
  price          BigInt
  feeBps         Int      @default(0)
  status         String   @default("ACTIVE")
  buyerId        String?
  version        Int      @default(1)
  createdAt      DateTime @default(now())
  expiresAt      DateTime?
  completedAt    DateTime?

  @@index([guildId, status, createdAt])
  @@index([guildId, sellerId, status])
  @@index([itemInstanceId, status])
}

model EconomyAuction {
  id               String   @id @default(cuid())
  guildId          String
  source           String   @default("USER")
  sellerId         String?
  itemInstanceId   String?
  itemDefinitionId String?
  createdBy        String
  startPrice       BigInt
  minIncrement     BigInt
  buyoutPrice      BigInt?
  currentBid       BigInt?
  currentBidderId  String?
  feeBps           Int      @default(0)
  status           String   @default("SCHEDULED")
  version          Int      @default(1)
  startsAt         DateTime
  endsAt           DateTime
  settledAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bids             EconomyAuctionBid[]

  @@index([guildId, status, startsAt])
  @@index([guildId, status, endsAt])
  @@index([guildId, sellerId, createdAt])
  @@index([itemInstanceId, status])
}

model EconomyAuctionBid {
  id        String         @id @default(cuid())
  auctionId String
  bidderId  String
  amount    BigInt
  createdAt DateTime       @default(now())
  auction   EconomyAuction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId, createdAt])
  @@index([auctionId, amount])
  @@index([bidderId, createdAt])
}

model EconomyEscrow {
  id          String   @id @default(cuid())
  guildId     String
  kind        String
  referenceId String
  userId      String
  amount      BigInt
  status      String   @default("HELD")
  metadata    Json?
  createdAt   DateTime @default(now())
  releasedAt  DateTime?

  @@index([guildId, kind, referenceId, status])
  @@index([guildId, userId, status])
}

model EconomyGameSession {
  id            String   @id @default(cuid())
  guildId       String
  requestId     String?  @unique
  gameType      String
  hostId        String
  opponentId    String?
  channelId     String?
  messageId     String?
  status        String   @default("WAITING")
  stake         BigInt   @default(0)
  pot           BigInt   @default(0)
  feeBps        Int      @default(0)
  winnerId      String?
  state         Json     @default("{}")
  version       Int      @default(1)
  expiresAt     DateTime?
  settledAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([guildId, gameType, status, createdAt])
  @@index([guildId, hostId, status])
  @@index([guildId, opponentId, status])
}

model EconomyLotteryRound {
  id                String                 @id @default(cuid())
  guildId           String
  title             String
  status            String                 @default("SCHEDULED")
  ticketPrice       BigInt
  maxTickets        Int?
  maxTicketsPerUser Int?
  feeBps            Int                    @default(0)
  pot               BigInt                 @default(0)
  winnerId     String?
  startsAt     DateTime
  endsAt       DateTime
  settledAt    DateTime?
  createdBy    String
  createdAt    DateTime               @default(now())
  tickets      EconomyLotteryTicket[]

  @@index([guildId, status, startsAt])
  @@index([guildId, status, endsAt])
}

model EconomyLotteryTicket {
  id        String              @id @default(cuid())
  roundId   String
  userId    String
  quantity  Int
  amount    BigInt
  createdAt DateTime            @default(now())
  round     EconomyLotteryRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, userId])
  @@index([userId, createdAt])
}

model MusicPlaylist {
  id        String               @id @default(cuid())
  guildId   String
  ownerId   String
  name      String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  tracks    MusicPlaylistTrack[]

  @@unique([guildId, ownerId, name])
  @@index([guildId, ownerId, updatedAt])
}

model MusicPlaylistTrack {
  id          String        @id @default(cuid())
  playlistId  String
  position    Int
  trackKey    String
  sourceName  String
  identifier  String
  title       String
  author      String
  uri         String?
  artworkUrl  String?
  durationMs  BigInt
  isStream    Boolean       @default(false)
  addedBy     String
  createdAt   DateTime      @default(now())
  playlist    MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@index([playlistId, trackKey])
}

model MusicFavorite {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  trackKey    String
  sourceName  String
  identifier  String
  title       String
  author      String
  uri         String?
  artworkUrl  String?
  durationMs  BigInt
  isStream    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([guildId, userId, trackKey])
  @@index([guildId, userId, createdAt])
}

model MusicHistory {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  trackKey    String
  sourceName  String
  identifier  String
  title       String
  author      String
  uri         String?
  artworkUrl  String?
  durationMs  BigInt
  isStream    Boolean  @default(false)
  playedAt    DateTime @default(now())

  @@index([guildId, userId, playedAt])
  @@index([guildId, playedAt])
}

model MusicPlayerState {
  guildId             String   @id
  voiceChannelId      String?
  textChannelId       String?
  controllerMessageId String?
  volume              Int      @default(50)
  positionMs          BigInt   @default(0)
  loopMode            String   @default("none")
  autoplay            Boolean  @default(false)
  stayConnected       Boolean  @default(false)
  lastTrack           Json?
  updatedAt           DateTime @updatedAt
}

model MusicQueueEntry {
  id          String   @id @default(cuid())
  guildId     String
  position    Int
  requesterId String
  trackKey    String
  sourceName  String
  identifier  String
  title       String
  author      String
  uri         String?
  artworkUrl  String?
  durationMs  BigInt
  isStream    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([guildId, position])
  @@index([guildId, position])
}

