generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminLevel {
  SUPERADMIN
  ADMIN
}

enum PunishmentType {
  WARN
  TIMEOUT
  MUTE
  KICK
  BAN
  TEMP_BAN
  UNWARN
  CLEAR
  SLOWMODE
  LOCK
  UNLOCK
}

enum PunishmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model GuildConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  locale    String   @default("ru")
  accentHex String   @default("#57F287")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  modules   ModuleConfig[]
}

model ModuleConfig {
  id        String      @id @default(cuid())
  guildId   String
  moduleKey String
  enabled   Boolean     @default(true)
  settings  Json        @default("{}")
  guild     GuildConfig @relation(fields: [guildId], references: [guildId], onDelete: Cascade)
  updatedAt DateTime    @updatedAt

  @@unique([guildId, moduleKey])
}

model AdminUser {
  id        String     @id @default(cuid())
  discordId String     @unique
  level     AdminLevel @default(ADMIN)
  addedBy   String?
  createdAt DateTime   @default(now())
  revokedAt DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  guildId    String
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([guildId, createdAt])
}

model ModerationCounter {
  guildId        String @id
  nextCaseNumber Int    @default(1)
}

model ModerationCase {
  id              String           @id @default(cuid())
  caseNumber      Int
  guildId         String
  targetUserId    String?          @map("userId")
  targetChannelId String?          @map("channelId")
  moderatorId     String
  type            PunishmentType
  status          PunishmentStatus @default(ACTIVE)
  reason          String
  evidence        Json?
  durationSeconds Int?
  expiresAt       DateTime?
  dmDelivered     Boolean?
  cancelledBy     String?
  cancelledAt     DateTime?
  createdAt       DateTime         @default(now())
  appeals         Appeal[]

  @@unique([guildId, caseNumber])
  @@index([guildId, targetUserId])
  @@index([guildId, targetChannelId])
  @@index([guildId, moderatorId, createdAt])
  @@index([guildId, status, expiresAt])
  @@map("Punishment")
}

model Appeal {
  id           String         @id @default(cuid())
  guildId      String
  caseId       String         @map("punishmentId")
  userId       String
  text         String
  status       String         @default("PENDING")
  reviewerId   String?
  reviewNote   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  case         ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([caseId, status])
}

model AutomodEvent {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  channelId String
  messageId String?
  ruleKey   String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([guildId, userId, createdAt])
  @@index([guildId, ruleKey, createdAt])
}

model UserProfile {
  id           String   @id @default(cuid())
  guildId      String
  userId       String
  xp           BigInt   @default(0)
  level        Int      @default(1)
  reputation   Int      @default(0)
  messages     BigInt   @default(0)
  voiceSeconds BigInt   @default(0)
  bio          String?
  links        Json?
  cosmetics    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([guildId, userId])
}

model EconomyAccount {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  wallet    BigInt   @default(0)
  bank      BigInt   @default(0)
  seasonId  String?
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
}

model EconomyTransaction {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  amount    BigInt
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([guildId, userId, createdAt])
}
