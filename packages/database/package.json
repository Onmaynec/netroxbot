{
  "name": "@netrox/database",
  "version": "0.7.0-dev.1",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "bootstrap": "node dist/src/bootstrap.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "build": "prisma generate && tsc -p tsconfig.json",
    "smoke:economy": "node dist/src/economy-smoke.js"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "dotenv": "^17.2.0",
    "pg": "^8.16.0",
    "@netrox/core": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "prisma": "7.10.0",
    "typescript": "~5.9.3"
  }
}
